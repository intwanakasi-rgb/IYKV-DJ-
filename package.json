{
  "name": "iyk-decklab",
  "version": "0.4.0",
  "description": "Free, local-first DJ mixing workspace by Intwana Yase Kasi",
  "author": "Intwana Yase Kasi",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "web:dev": "vite --host 0.0.0.0",
    "web:build": "vite build --base=./ --outDir dist/web",
    "desktop": "electron .",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "package:linux": "electron-builder --linux AppImage --x64 --publish never",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check app.js && node --check desktop/main.cjs && node --check scripts/windows-signing.cjs && node --check electron-builder.signed.cjs && node --check server/submissions.cjs && node --check server/submit.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "package:win:signed": "node scripts/windows-signing.cjs",
    "preweb:dev": "node scripts/write-version.cjs",
    "preweb:build": "node scripts/write-version.cjs",
    "predesktop": "node scripts/write-version.cjs",
    "prepackage:win": "node scripts/write-version.cjs",
    "prepackage:linux": "node scripts/write-version.cjs",
    "prepackage:win:signed": "node scripts/write-version.cjs",
    "submissions:serve": "node server/submissions.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "org.intwanayasekasi.decklab",
    "productName": "IYK DeckLab",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "README.md",
      "LICENSE",
      "desktop/**/*",
      "package.json",
      "app-version.js",
      "scratch-worklet.js"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "IYK-DeckLab-Windows-Installer.${ext}",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "IYK-DeckLab-${version}.${ext}"
    }
  }
}
